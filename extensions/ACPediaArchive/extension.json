{
  "name": "ACPediaArchive",
  "version": "1.3.0",
  "author": "ACPedia restoration contributors",
  "url": "https://github.com/dustinsilva/acpedia",
  "description": "Preserves ACPedia's archived nested sidebar on supported MediaWiki.",
  "license-name": "MIT",
  "type": "other",
  "AutoloadClasses": {
    "ACPediaArchiveHooks": "Hooks.php",
    "SpecialACPediaCredits": "SpecialACPediaCredits.php"
  },
  "Hooks": {
    "SkinBuildSidebar": "ACPediaArchiveHooks::onSkinBuildSidebar",
    "BeforePageDisplay": "ACPediaArchiveHooks::onBeforePageDisplay",
    "HtmlPageLinkRendererBegin": "ACPediaArchiveHooks::onHtmlPageLinkRendererBegin",
    "ParserFirstCallInit": "ACPediaArchiveHooks::onParserFirstCallInit",
    "SkinAddFooterLinks": "ACPediaArchiveHooks::onSkinAddFooterLinks"
  },
  "ResourceModules": {
    "ext.acpedia.archive": {
      "styles": [
        "sidebar.css"
      ]
    },
    "ext.acpedia.search": {
      "scripts": [
        "search.js"
      ],
      "dependencies": [
        "mediawiki.searchSuggest",
        "mediawiki.api",
        "jquery"
      ]
    }
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteExtPath": "ACPediaArchive"
  },
  "manifest_version": 2,
  "SpecialPages": {
    "ACPediaCredits": "SpecialACPediaCredits"
  },
  "MessagesDirs": {
    "ACPediaArchive": [
      "i18n"
    ]
  },
  "ExtensionMessagesFiles": {
    "ACPediaArchiveAlias": "ACPediaArchive.alias.php"
  }
}
